	partition 'Dim Product-csv' = m
		mode: import
		source =
				let
				    CsvRaw = Csv.Document(File.Contents("C:\Users\seong\Downloads\이력서\brewly-growth-simulator\powerbi-ba-case\data\model\dim_product.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    WithHeaders = Table.PromoteHeaders(CsvRaw, [PromoteAllScalars = true]),
				    TypedTable = Table.TransformColumnTypes(WithHeaders, {{"sku", type text}, {"product_name", type text}, {"product_type", type text}, {"unit_price_krw", Int64.Type}}, "en-US")
				in
				    TypedTable

