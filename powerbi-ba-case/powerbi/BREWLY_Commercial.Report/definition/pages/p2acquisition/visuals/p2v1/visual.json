{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.14.0/schema.json",
  "name": "p2v1",
  "position": {
    "x": 10,
    "y": 85,
    "z": 2000,
    "height": 385,
    "width": 625,
    "tabOrder": 2000
  },
  "visual": {
    "visualType": "columnChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Dim Week"
                    }
                  },
                  "Property": "quarter"
                }
              },
              "queryRef": "Dim Week.quarter",
              "nativeQueryRef": "quarter",
              "active": true,
              "displayName": "Quarter"
            }
          ]
        },
        "Series": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Dim Channel"
                    }
                  },
                  "Property": "channel_name"
                }
              },
              "queryRef": "Dim Channel.channel_name",
              "nativeQueryRef": "channel_name",
              "displayName": "Channel"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Acquisition Spend (KRW)"
                }
              },
              "queryRef": "_Measures.Acquisition Spend (KRW)",
              "nativeQueryRef": "Acquisition Spend (KRW)"
            }
          ]
        }
      }
    },
    "objects": {
      "valueAxis": [
        {
          "properties": {
            "labelDisplayUnits": {
              "expr": {
                "Literal": {
                  "Value": "1D"
                }
              }
            }
          }
        }
      ]
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Acquisition spend by channel (KRW)'"
                }
              }
            }
          }
        }
      ],
      "subTitle": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}