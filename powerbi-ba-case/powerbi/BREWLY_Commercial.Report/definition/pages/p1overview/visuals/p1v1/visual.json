{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.14.0/schema.json",
  "name": "p1v1",
  "position": {
    "x": 10,
    "y": 200,
    "z": 7000,
    "height": 510,
    "width": 820,
    "tabOrder": 7000
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Dim Week"
                    }
                  },
                  "Property": "week_start"
                }
              },
              "queryRef": "Dim Week.week_start",
              "nativeQueryRef": "week_start",
              "active": true,
              "displayName": "Week"
            }
          ]
        },
        "Series": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Dim Region"
                    }
                  },
                  "Property": "region_name"
                }
              },
              "queryRef": "Dim Region.region_name",
              "nativeQueryRef": "region_name",
              "displayName": "Region"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Refill Orders"
                }
              },
              "queryRef": "_Measures.Refill Orders",
              "nativeQueryRef": "Refill Orders"
            }
          ]
        }
      }
    },
    "objects": {
      "valueAxis": [
        {
          "properties": {
            "labelDisplayUnits": {
              "expr": {
                "Literal": {
                  "Value": "1D"
                }
              }
            }
          }
        }
      ]
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Weekly refill orders by region'"
                }
              }
            }
          }
        }
      ],
      "subTitle": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}